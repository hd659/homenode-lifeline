<?xml version="1.0" encoding="UTF-8"?>
<!-- 复制到 ~/Library/LaunchAgents/，把 /path/to 改成实际路径后：
     launchctl load ~/Library/LaunchAgents/com.example.homenode-lifeline.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.homenode-lifeline</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-m</string>
    <string>homenode_lifeline</string>
    <string>watch</string>
    <string>--interval</string>
    <string>300</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/path/to/homenode-lifeline</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/homenode-lifeline.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/homenode-lifeline.log</string>
</dict>
</plist>
